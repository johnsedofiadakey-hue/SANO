# ═══════════════════════════════════════════════════════
# SANO Mobile App — Environment Variables
# Run: cp .env.example .env
# Check status: node ../scripts/check-env.js
# ═══════════════════════════════════════════════════════

# DEMO MODE — set true to run without any keys
# Remove or set to false when you have real keys
EXPO_PUBLIC_DEMO_MODE=true

# ── FIREBASE (console.firebase.google.com) ──────────────
# Project Settings → Your apps → Config object
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── BACKEND (Render URL after deploy) ──────────────────
EXPO_PUBLIC_API_URL=https://sano-api.onrender.com

# ── ANALYTICS (posthog.com → free tier) ────────────────
EXPO_PUBLIC_POSTHOG_KEY=

# ── ERROR TRACKING (sentry.io → free tier) ─────────────
EXPO_PUBLIC_SENTRY_DSN=

# ── PAYMENTS (dashboard.paystack.com → Settings → API Keys) ──
# Public key is safe to include here — only for checkout UI
# SECRET key goes ONLY in backend/.env — never here
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
