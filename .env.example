# ═══════════════════════════════════════════════════════════════
# SANO — Environment Variables
# Run: cp .env.example .env
# Check status: npx ts-node scripts/check-env.ts
# ═══════════════════════════════════════════════════════════════

# ─── DEMO MODE ────────────────────────────────────────────────────────────────
# Set to true → full app works with zero API keys. Firebase NOT initialized.
EXPO_PUBLIC_DEMO_MODE=true


# ─── FIREBASE (get in 20 min — see FIREBASE_SETUP.md) ────────────────────────
# console.firebase.google.com → Project settings → Your apps → Web app → Config

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend only — Firebase Admin SDK (for Render)
# Project settings → Service accounts → Generate new private key → paste JSON as one line
FIREBASE_ADMIN_SDK_JSON=


# ─── RENDER (after deploying — see RENDER_SETUP.md) ──────────────────────────
# Your deployed Express backend URL
EXPO_PUBLIC_API_URL=https://sano-api.onrender.com

# Set in backend's Render env vars (not in mobile .env)
RENDER_AI_URL=https://sano-ai.onrender.com


# ─── AI ───────────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
# Set in backend's Render dashboard, not here
ANTHROPIC_API_KEY=


# ─── ANALYTICS ────────────────────────────────────────────────────────────────
# app.posthog.com → free tier → Project → API Key
EXPO_PUBLIC_POSTHOG_KEY=


# ─── PAYMENTS ─────────────────────────────────────────────────────────────────
# dashboard.flutterwave.com → Settings → API Keys
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# Set on Render backend only — never in mobile bundle
FLUTTERWAVE_SECRET_KEY=
