# ═══════════════════════════════════════════════════════════════
# SANO — Environment Variables
# Run: cp .env.example .env  then fill in the keys you have
# Check status: npx ts-node scripts/check-env.ts
# ═══════════════════════════════════════════════════════════════

# ─── DEMO MODE (start here) ─────────────────────────────────────
# Set to true to run the full app with zero external services.
# Everything works with realistic mock data.
EXPO_PUBLIC_DEMO_MODE=true


# ─── MOBILE APP (EXPO_PUBLIC_ prefix = exposed to client) ───────

# Backend API — use localhost:3000 for local dev
# Get at: railway.app (free tier) for hosted backend
EXPO_PUBLIC_API_URL=http://localhost:3000

# PostHog analytics — free tier: 1M events/month
# Get at: app.posthog.com → Projects → API Key
EXPO_PUBLIC_POSTHOG_KEY=

# Flutterwave — Ghana MoMo + card payments
# Get at: dashboard.flutterwave.com → Settings → API Keys
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Stripe — card payments for diaspora users
# Get at: dashboard.stripe.com → Developers → API Keys
EXPO_PUBLIC_STRIPE_PUBLIC_KEY=


# ─── BACKEND ONLY (never prefix with EXPO_PUBLIC_) ──────────────

# JWT signing secret — generate with: openssl rand -hex 32
# IMPORTANT: change before going to production
JWT_SECRET=change_this_to_a_long_random_string_in_production

# PostgreSQL — for production. SQLite is used automatically for local dev.
# Get at: railway.app → New Project → Provision PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/sano

# Cloudflare R2 — image storage (cheaper than S3, no egress fees)
# Get at: cloudflare.com/r2 → Create bucket named "sano-images"
R2_BUCKET_NAME=sano-images
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Claude AI — powers SANO Derm chat
# Get at: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Port for backend server (default 3000)
PORT=3000


# ─── AI SERVICE ──────────────────────────────────────────────────

# URL of the Python FastAPI service
# Run locally: cd sano-ai && uvicorn main:app --reload --port 8001
AI_SERVICE_URL=http://localhost:8001
