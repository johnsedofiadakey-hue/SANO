# ═══════════════════════════════════════════════════════
# SANO Backend — Environment Variables
# Set these in Render dashboard (not committed)
# ═══════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# Firebase Admin SDK
# Project Settings → Service accounts → Generate new private key
# Paste entire JSON as one line (replace real newlines with \n)
FIREBASE_ADMIN_SDK_JSON=

# AI (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# ── PAYMENTS — SECRET KEY BACKEND ONLY ─────────────────
# dashboard.paystack.com → Settings → API Keys → Secret Key
# ⚠️  NEVER put the secret key in the mobile app or any frontend file.
# ⚠️  Regenerate your key at Paystack if it was ever exposed.
PAYSTACK_SECRET_KEY=

# AI Service URL (your Render sano-ai service)
AI_SERVICE_URL=https://sano-1.onrender.com
AI_SERVICE_SECRET=

# Self URL — used to keep the Render free tier awake with a /health ping every 10 min
# Set to your Render backend URL, e.g. https://sano-s32p.onrender.com
SELF_URL=
