// This is your Prisma schema file
// SQLite is used for local dev — Json fields are stored as String (JSON.stringify/parse in routes)
// To switch to PostgreSQL for production: change provider + url + change all String (json) back to Json

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String         @id @default(uuid())
  phone_hash      String?        @unique
  email_hash      String?        @unique
  region          String?
  age_group       String?
  fitzpatrick     Int?
  primary_concern String?
  subscription    String         @default("free")
  research_opt_in Boolean        @default(false)
  created_at      DateTime       @default(now())
  scans           Scan[]
  health_events   HealthEvent[]
  consent_logs    ConsentLog[]
  routines        Routine[]
  cycle_logs      CycleLog[]
}

model Scan {
  id               String   @id @default(uuid())
  user_id          String
  image_key        String
  skin_tone        Int?
  conditions       String   @default("[]") // JSON string — parse on read
  products_in_use  String   @default("[]") // JSON string
  cycle_day        Int?
  region           String?
  season           String?
  phone_model      String?
  model_version    String?
  doctor_confirmed Boolean  @default(false)
  share_count      Int      @default(0)
  created_at       DateTime @default(now())
  user             User     @relation(fields: [user_id], references: [id])
}

model HealthEvent {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  value      String   @default("{}") // JSON string
  device     String?
  confidence Float?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model ConsentLog {
  id             String   @id @default(uuid())
  user_id        String
  action         String
  feature        String
  policy_version String
  created_at     DateTime @default(now())
  user           User     @relation(fields: [user_id], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  brand       String
  ingredients String   @default("[]") // JSON string
  barcode     String?  @unique
  verified    Boolean  @default(false)
  created_at  DateTime @default(now())
}

model Routine {
  id         String   @id @default(uuid())
  user_id    String
  steps      String   @default("[]") // JSON string
  conflicts  String   @default("[]") // JSON string
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])
}

model CycleLog {
  id           String    @id @default(uuid())
  user_id      String
  period_start DateTime
  period_end   DateTime?
  symptoms     String    @default("[]") // JSON string
  cycle_day    Int
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id])
}

model AnalyticEvent {
  id         String   @id @default(uuid())
  event_type String
  payload    String   @default("{}") // JSON string
  queued_at  String?
  created_at DateTime @default(now())
}
