{
  "expo": {
    "name": "SANO",
    "slug": "sano-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#7C3AED",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sanohealth.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SANO uses your camera to analyse your skin and detect conditions.",
        "NSMicrophoneUsageDescription": "SANO uses the microphone for video scan sessions.",
        "NSPhotoLibraryUsageDescription": "SANO accesses your photo library to upload scan images.",
        "NSLocationWhenInUseUsageDescription": "SANO uses approximate location to find nearby pharmacies."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "package": "com.sanohealth.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-notifications",
        {
          "color": "#7C3AED"
        }
      ]
    ],
    "scheme": "sano",
    "experiments": {
      "typedRoutes": true
    }
  }
}
