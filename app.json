{
  "expo": {
    "name": "SANO",
    "slug": "sano-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#7C3AED",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sanohealth.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SANO needs camera access to scan your skin",
        "NSMicrophoneUsageDescription": "SANO needs microphone access for cough analysis",
        "NSPhotoLibraryUsageDescription": "SANO needs photo access to save your scan results"
      }
    },
    "android": {
      "package": "com.sanohealth.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-notifications",
        {
          "color": "#7C3AED"
        }
      ]
    ],
    "scheme": "sano",
    "experiments": {
      "typedRoutes": true
    }
  }
}
