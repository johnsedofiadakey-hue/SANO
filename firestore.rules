rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Scans — users own their own; never deleted
    match /scans/{scanId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['doctorConfirmed', 'queuedForLabel', 'modelVersion', 'condition']);
      allow delete: if false;
    }

    // Health events — same pattern; never deleted
    match /health_events/{eventId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }

    // Cycle logs
    match /cycle_logs/{logId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Routines — keyed by userId
    match /routines/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Consent log — immutable once written
    match /consent_log/{logId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false;
      allow delete: if false;
    }

    // Analytics events — any authenticated user can write; backend reads only
    match /analytics_events/{eventId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['userId', 'type', 'data', 'createdAt'])
                    && request.resource.data.type is string
                    && request.resource.data.data is map;
      allow read:   if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
