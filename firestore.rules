rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Scans — users own their own; never deleted
    match /scans/{scanId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['doctorConfirmed', 'queuedForLabel', 'modelVersion', 'condition']);
      allow delete: if false;
    }

    // Health events — same pattern; never deleted
    match /health_events/{eventId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }

    // Cycle logs
    match /cycle_logs/{logId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Routines — keyed by userId
    match /routines/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Consent log — immutable once written
    match /consent_log/{logId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false;
      allow delete: if false;
    }

    // Analytics events — any authenticated user can write; backend reads only
    match /analytics_events/{eventId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['userId', 'type', 'data', 'createdAt'])
                    && request.resource.data.type is string
                    && request.resource.data.data is map;
      allow read:   if false;
    }

    // Community posts — any authenticated user can read; author can delete own
    match /community_posts/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 10
                    && request.resource.data.text.size() <= 500;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.uid
                        || request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['likeCount', 'likedBy', 'replyCount', 'flaggedBy']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      // Replies subcollection
      match /replies/{replyId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() >= 2;
        allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }
    }

    // Consultations — patient and assigned doctor can read; patients create
    match /consultations/{consultId} {
      allow read:   if request.auth != null
                    && (request.auth.uid == resource.data.patientUid
                        || request.auth.uid == resource.data.doctorUid);
      allow create: if request.auth != null
                    && request.resource.data.patientUid == request.auth.uid;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.patientUid
                        || request.auth.uid == resource.data.doctorUid);
      allow delete: if false;
    }

    // Doctors — read-only for authenticated users
    match /doctors/{doctorId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Label queue — backend admin only (Firebase Admin SDK bypasses rules)
    match /label_queue/{itemId} {
      allow read, write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
